{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Django",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/sailmanager/manage.py",
      "args": [
        "runserver",
        "--noreload"
      ],
      "django": true,
      "justMyCode": false
    },
    {
      "name": "Python: Django debug command",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/sailmanager/manage.py",
      "args": [
        "createWeeksRaces"
      ],
      "django": true,
      "justMyCode": false
    },
    {
      "name": "Containers: Python - Django",
      "type": "debugpy",
      "request": "attach",
      "preLaunchTask": "docker-compose-up",
      // "postDebugTask": "docker-compose-down",
      "connect": {
                "host": "localhost",
                "port": 5678 // This is the debugpy port exposed by your Django service
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/sailmanager", // Map your local workspace to the remote work directory
                    "remoteRoot": "/sailmanager" // Assuming your Dockerfile sets WORKDIR to /usr/src/app
                }
            ],
            "justMyCode": false // Set to false to debug into Django/library code if needed
    }
  ]
}
